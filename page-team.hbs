      <div class="container mt-16">
          <template x-for="[category, members] in Object.entries(team.board)">
            <div>
              <h2 class="featured-title" style="font-size:3rem;" x-text="category">[CATEGORY]</h2>
              <br>
              <div class="flex flex-wrap -m-4">
                <template x-for="member in members">
                  <div class= "p-4 basis-1/2 md:basis-1/3 lg:basis-1/4"> <!--"p-4 lg:w-1/4 md:w-1/2">-->
                    <div class="h-full flex flex-col items-center text-center">
                        <a x-bind:href="member.href">
                            <img class="shadow rounded-full w-96 aspect-square align-middle border-none" x-bind:src="member.img_src" x-bind:alt="head.name">
                        </a>
                        <div class="p-4 text-center font-normal">
                          <p>
                            <b x-text="member.name">[MEMBER]</b>
                            <br>
                            <span x-text="member.note">[NOTE]</span>
                          </p>
                        </div>
                    </div>
                  </div>
                </template>                                                 
